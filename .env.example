# Docker Compose interpolation only. Application secrets belong in backend/.env.
# Copy to .env for Compose. Production: use your real HTTPS URL and media origins.
SITE_URL=http://localhost:3000
FRONTEND_HOST_PORT=3000
BACKEND_HOST_PORT=8000
POSTGRES_HOST_PORT=15432
REDIS_HOST_PORT=16379
# Optional origins for audio/images returned by storage (comma-separated).
# Example: https://your-project.supabase.co,https://your-backend.example.com
MEDIA_ORIGINS=
GA_TRACKING_ID=
# Optional override for the backend environment file.
BACKEND_ENV_FILE=./backend/.env
