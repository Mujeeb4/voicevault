# Copy to .env.local for local development. No backend secrets belong here.
BACKEND_API_URL=http://127.0.0.1:8000/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Origins used by returned audio/image URLs, e.g. https://your-project.supabase.co
NEXT_PUBLIC_MEDIA_ORIGINS=
NEXT_PUBLIC_GA_TRACKING_ID=
# Rebuild after changing the backend URL or NEXT_PUBLIC_* variables.
