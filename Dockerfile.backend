# Dockerfile.backend
# Specialized for Django Backend Service

# Use a lean Python image
FROM python:3.11-slim

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    postgresql-client \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt .
RUN pip install --upgrade pip && \
    pip install -r requirements.txt

# Copy project files
COPY . .

# Collect static files
RUN python manage.py collectstatic --noinput

# Remove frontend directory to save space (optional, but good practice)
RUN rm -rf frontend

# Expose port (Render sets $PORT dynamically)
ENV PORT=8000
EXPOSE $PORT

# Start Gunicorn directly (no Supervisor needed for single process)
# We bind to 0.0.0.0:$PORT
CMD gunicorn config.wsgi:application --bind 0.0.0.0:$PORT --workers 1 --timeout 120 --preload
