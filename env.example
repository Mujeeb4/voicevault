# ============================================================================
# VoiceVault Backend - Environment Variables
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!
# ============================================================================

# ----------------------------------------------------------------------------
# DJANGO SETTINGS
# ----------------------------------------------------------------------------

# Generate a new secret key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here-change-this-in-production

# Set to False in production
DEBUG=True

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS settings (comma-separated list)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Public frontend URL used for metadata, redirects, invite links, and CSP.
FRONTEND_URL=http://127.0.0.1:13000
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:13000

# Docker host ports. Keep HOST_BIND_IP as 127.0.0.1 when Traefik is proxying
# over the Docker network. Use 0.0.0.0 only when intentionally exposing the
# direct host ports, such as http://72.61.76.103:13000.
HOST_BIND_IP=127.0.0.1
FRONTEND_HOST_PORT=13000
BACKEND_HOST_PORT=18000

# Optional Traefik settings.
# For temporary Hostinger URLs:
# TRAEFIK_HOST=72.61.76.103
# TRAEFIK_RULE=Host(`72.61.76.103`) || Host(`web.srv1183929.hstgr.cloud`) || Host(`voicevault-web.srv1183929.hstgr.cloud`)
# TRAEFIK_ENTRYPOINT=web
# TRAEFIK_TLS=false
#
# For a real HTTPS domain, also include docker-compose.traefik-https.yml and use
# the resolver name that exists in your Traefik static config. In the current
# Hostinger logs that resolver appears to be "letsencrypt", not "mytlschallenge".
# TRAEFIK_HOST=voicevault.example.com
# TRAEFIK_RULE=Host(`voicevault.example.com`)
# TRAEFIK_CERT_RESOLVER=letsencrypt
TRAEFIK_NETWORK=traefik-yuy7_default


# ----------------------------------------------------------------------------
# DATABASE (SUPABASE POSTGRESQL)
# ----------------------------------------------------------------------------
# Get these from your Supabase project settings:
# Project Settings -> Database -> Connection String
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-database-password
DB_HOST=your-supabase-pooler-host.supabase.com
DB_PORT=5432
DATABASE_URL=postgresql://postgres.your-project-ref:your-database-password@your-supabase-pooler-host.supabase.com:5432/postgres

# ----------------------------------------------------------------------------
# SUPABASE CONFIGURATION
# ----------------------------------------------------------------------------
# Get these from your Supabase project settings:
# Project Settings -> API

STORAGE_BACKEND=supabase
LOCAL_STORAGE_PUBLIC_URL=http://localhost:8000
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Storage bucket names (default values, change if needed)
SUPABASE_STORAGE_BUCKET_RECORDINGS=recordings
SUPABASE_STORAGE_BUCKET_RESPONSES=responses


# ----------------------------------------------------------------------------
# REDIS (FOR CELERY)
# ----------------------------------------------------------------------------
# Local development: redis://localhost:6379/0
# Production: Use your Redis instance URL

REDIS_URL=redis://localhost:6379/0


# ----------------------------------------------------------------------------
# OPENAI API
# ----------------------------------------------------------------------------
# Get your API key from: https://platform.openai.com/api-keys
# Required for:
# - Audio transcription (Whisper)
# - Personality analysis (GPT-4)
# - Chat responses (GPT-4o)

OPENAI_API_KEY=your-openai-api-key

# Optional: Specify the model (default: gpt-4o for optimal performance)
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_ANALYSIS_MODEL=gpt-4


# ----------------------------------------------------------------------------
# ELEVENLABS API
# ----------------------------------------------------------------------------
# Get your API key from: https://elevenlabs.io/app/settings/api-keys
# Required for:
# - Voice cloning
# - Text-to-speech generation

ELEVENLABS_API_KEY=your-elevenlabs-api-key

# Optional: Specify the model (default: eleven_turbo_v2_5 for speed)
ELEVENLABS_MODEL=eleven_turbo_v2_5


# ----------------------------------------------------------------------------
# STRIPE PAYMENTS
# ----------------------------------------------------------------------------
# Get these from: https://dashboard.stripe.com/apikeys
# Use test keys (sk_test_...) for development
# Use live keys (sk_live_...) for production

STRIPE_MODE=test

# Backward-compatible fallback keys. Prefer the mode-specific keys below.
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key

# Webhook signing secret (from Stripe Dashboard -> Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Test mode configuration
STRIPE_TEST_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_TEST_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_TEST_WEBHOOK_SECRET=whsec_your-test-webhook-secret
STRIPE_TEST_PREMIUM_ONE_TIME_PRICE_ID=price_your_test_14999_price_id

# Live mode configuration
STRIPE_LIVE_SECRET_KEY=sk_live_your-stripe-secret-key
STRIPE_LIVE_PUBLISHABLE_KEY=pk_live_your-stripe-publishable-key
STRIPE_LIVE_WEBHOOK_SECRET=whsec_your-live-webhook-secret
STRIPE_LIVE_PREMIUM_ONE_TIME_PRICE_ID=price_your_live_14999_price_id

# Premium is a one-time $149.99 payment for one vault.
STRIPE_PREMIUM_ONE_TIME_PRICE_ID=price_your_default_14999_price_id
STRIPE_PREMIUM_ONE_TIME_AMOUNT_CENTS=14999
STRIPE_PREMIUM_CURRENCY=usd

# Legacy price IDs retained for older deployments. New checkout uses the one-time price above.
STRIPE_LITE_PRICE_ID=
STRIPE_PREMIUM_PRICE_ID=
STRIPE_FAMILY_PRICE_ID=


# ----------------------------------------------------------------------------
# EMAIL SETTINGS (OPTIONAL - For invitations and notifications)
# ----------------------------------------------------------------------------
# For development, you can use console backend
# For production, configure SMTP or use a service like SendGrid

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-smtp-user@example.com
EMAIL_HOST_PASSWORD=your-smtp-password-or-app-password
DEFAULT_FROM_EMAIL=VoiceVault <noreply@voicevault.com>


# ----------------------------------------------------------------------------
# CACHING (OPTIONAL - For production performance)
# ----------------------------------------------------------------------------
# Use Redis for caching in production
# Development can use local memory cache

# CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
# CACHE_LOCATION=redis://127.0.0.1:6379/1


# ----------------------------------------------------------------------------
# LOGGING (OPTIONAL)
# ----------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log to file (optional)
# LOG_FILE=/var/log/voicevault/app.log


# ----------------------------------------------------------------------------
# FRONTEND CONFIGURATION (OPTIONAL - If you have a frontend)
# ----------------------------------------------------------------------------
# URL of your frontend application
FRONTEND_URL=http://localhost:3000

# Frontend server-side proxy target. This is NOT exposed to browser bundles.
# Browser requests should use same-origin /api unless you intentionally set NEXT_PUBLIC_API_URL.
BACKEND_API_URL=http://127.0.0.1:8000/api

# Optional public override. Leave empty in production if you want browser Network to show /api only.
NEXT_PUBLIC_API_URL=


# ----------------------------------------------------------------------------
# SECURITY SETTINGS (PRODUCTION ONLY)
# ----------------------------------------------------------------------------
# Uncomment and set these for production deployment

# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True


# ----------------------------------------------------------------------------
# PERFORMANCE TUNING (OPTIONAL)
# ----------------------------------------------------------------------------
# Celery worker concurrency (number of worker processes)
# CELERY_WORKER_CONCURRENCY=4

# Celery task time limit (seconds)
# CELERY_TASK_TIME_LIMIT=1800

# Max file upload size (bytes) - Default: 100MB
# MAX_UPLOAD_SIZE=104857600


# ----------------------------------------------------------------------------
# DEVELOPMENT / TESTING (OPTIONAL)
# ----------------------------------------------------------------------------
# Set to True to use SQLite for local testing
# USE_SQLITE_FOR_TESTING=False

# Disable Supabase integration for local testing
# DISABLE_SUPABASE_AUTH=False


# ============================================================================
# NOTES:
# ============================================================================
# 1. Copy this file to .env in the same directory
# 2. Fill in all the required values (marked with "your-...")
# 3. Never commit .env to version control (it's in .gitignore)
# 4. Keep your API keys secure and rotate them regularly
# 5. Use different keys for development and production
# 6. For production, set DEBUG=False and configure security settings
# ============================================================================

# ============================================================================
# QUICK START CHECKLIST:
# ============================================================================
# [ ] Generate Django SECRET_KEY
# [ ] Create Supabase project and get credentials
# [ ] Set up database connection (DB_*)
# [ ] Get OpenAI API key
# [ ] Get ElevenLabs API key
# [ ] Set up Stripe account and get keys
# [ ] Configure Redis for Celery
# [ ] Create Supabase storage buckets
# [ ] Test all connections
# ============================================================================
