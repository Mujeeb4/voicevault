# VoiceVault backend only. Copy to backend/.env for local development.
# Hosting providers should set environment variables directly. Real .env files
# are ignored by Git and excluded from Docker build contexts.
DEBUG=True
# Generate production value: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
ADMIN_EMAILS=

# Public frontend origin used for invite links and payment redirects.
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_ALL_ORIGINS=False
# Production defaults follow DEBUG=False: HTTPS redirects, secure cookies, HSTS.
# Set SECURE_SSL_REDIRECT=False only for local HTTP Docker development.
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000

# PostgreSQL. Use managed PostgreSQL with TLS in production.
DATABASE_URL=postgresql://voicevault:voicevault@localhost:5432/voicevault
# Local hosts/db/postgres default to False; remote hosts default to True.
# DB_SSL_REQUIRE=True
# Without DATABASE_URL: DB_NAME, DB_USER, DB_PASSWORD, DB_HOST, DB_PORT.

# Shared cache and Celery broker. Required in production for multi-process
# invitation tokens, throttles, and background AI tasks. Start a separate worker:
# celery -A config worker -Q celery,default,transcription,voice,analysis --loglevel=info
# TLS Redis URLs (rediss://) verify server certificates.
REDIS_URL=redis://localhost:6379/0
# Optional overrides; normally both inherit REDIS_URL.
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=
CELERY_TASK_ALWAYS_EAGER=False

# Object storage: use supabase in production. Service role key stays server-side.
# Local mode is for development and requires a persistent MEDIA_ROOT directory.
STORAGE_BACKEND=local
LOCAL_STORAGE_PUBLIC_URL=http://localhost:8000
# MEDIA_ROOT=/app/media
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET_RECORDINGS=recordings
SUPABASE_STORAGE_BUCKET_RESPONSES=responses

# Transcription and personality analysis require OpenAI; chat can use Qwen.
OPENAI_API_KEY=
OPENAI_ANALYSIS_MODEL=gpt-4.1-mini
OPENAI_CHAT_MODEL=gpt-4o
CHAT_PROVIDER=openai
QWEN_API_KEY=
QWEN_CHAT_MODEL=qwen3.8-flash
QWEN_CHAT_BASE_URL=https://token-plan.maas.qwencloudapi.com/compatible-mode/v1

# Select elevenlabs or replicate. Set credentials for the selected provider.
VOICE_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_v3
REPLICATE_API_TOKEN=
REPLICATE_MODEL_VERSION=d490a561cf1171a8dc3d96d1e57efffea7dd34607148bb641f3d9de4e38c472e
REPLICATE_WEBHOOK_KEY=
# Public HTTPS backend callback for Replicate voice audio:
# REPLICATE_WEBHOOK_URL=https://api.example.com/api/chat/replicate/webhook/
REPLICATE_WEBHOOK_URL=

# Stripe one-time premium checkout. Switch mode and configure corresponding
# keys on production. Blank mode-specific settings use generic values below.
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_ONE_TIME_PRICE_ID=
STRIPE_PREMIUM_ONE_TIME_AMOUNT_CENTS=14999
STRIPE_PREMIUM_CURRENCY=usd
# STRIPE_TEST_SECRET_KEY=
# STRIPE_TEST_PUBLISHABLE_KEY=
# STRIPE_TEST_WEBHOOK_SECRET=
# STRIPE_TEST_PREMIUM_ONE_TIME_PRICE_ID=
# STRIPE_LIVE_SECRET_KEY=
# STRIPE_LIVE_PUBLISHABLE_KEY=
# STRIPE_LIVE_WEBHOOK_SECRET=
# STRIPE_LIVE_PREMIUM_ONE_TIME_PRICE_ID=

# Console mail is useful locally. For hosting, select SMTP and provide credentials.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=VoiceVault <noreply@example.com>
LOG_LEVEL=INFO
